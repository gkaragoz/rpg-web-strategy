{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run check:fast)",
      "Bash(npm run lint:repo)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh release list:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh release delete:*)",
      "Bash(gh run delete:*)"
    ],
    "deny": [
      "Read(./dist/**)",
      "Read(./node_modules/**)",
      "Read(./test-results/**)",
      "Read(./package-lock.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node scripts/hooks/guard.mjs" }
        ]
      }
    ]
  }
}
