{
  "name": "rpg-web",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "gkaragoz",
  "repository": {
    "type": "git",
    "url": "https://github.com/gkaragoz/rpg-web-strategy.git"
  },
  "version": "2.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit && node scripts/check-repo.mjs && node scripts/check-layers.mjs && vitest run",
    "check:fast": "tsc --noEmit && node scripts/check-repo.mjs && node scripts/check-layers.mjs && vitest run --exclude \"**/{fuzz,rosterfuzz,comedy,mapSpec,mapmodesaudit,onlinesetup,economy,troops,determinism,snapsize,crowd}.test.ts\"",
    "lint:repo": "node scripts/check-repo.mjs",
    "lint:layers": "node scripts/check-layers.mjs",
    "test:cov": "vitest run --coverage",
    "test:golden": "vitest run golden",
    "e2e": "node scripts/e2e.mjs",
    "test:visual": "node scripts/visual.mjs",
    "bench:sim": "node scripts/bench-sim.mjs",
    "balance": "node scripts/balance.mjs",
    "balance:quick": "node scripts/balance.mjs --quick",
    "balance:calibrate": "node scripts/balance.mjs --quick --calibrate 8 --write",
    "test:fast": "vitest run --exclude \"**/{fuzz,rosterfuzz,comedy,mapSpec,mapmodesaudit,onlinesetup,economy,troops,determinism,snapsize,crowd}.test.ts\"",
    "test:net": "vitest run net lan chunk onlinesetup",
    "test:sim": "vitest run skills troops edge terrain determinism crowd comedy armies economy mapSpec mapmodes",
    "screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "peerjs": "1.5.4",
    "pixi.js": "^8.22.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "0.170.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
